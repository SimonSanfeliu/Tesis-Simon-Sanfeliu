162.44469910022,1.0,1499564341415015015,-999.0,""null"",59253.56434029993,2],[""ZTF18abbxrwg"",1185,58287.3354282002,61162.44469910022,1.0,1499564341415015015,-999.0,""null"",59253.56434029993,2],[""ZTF18abcweza"",548,58293.33767359983,61162.44469910022,1.0,1499569200315015005,-999.0,""null"",59253.56920140004,2],[""ZTF18abdlapp"",582,58301.33584489999,61162.441411999986,1.0,1504522532115010007,-999.0,""null"",59258.52253470011,1],[""ZTF18abdlapp"",582,58301.33584489999,61162.441411999986,1.0,1504522532115010007,-999.0,""null"",59258.52253470011,1],[""ZTF18abctcjx"",1312,58301.35591439996,61163.439074099995,1.0,1508557300615015050,-999.0,""null"",59262.55730320001,2]],""format"":""dataframe_split"",""version"":1}",,63.583781480789185,2026-05-06T10:51:21,0.6,0.6,1.0,1.0,0,1
0.22.0,gpt-5.2-codex,v4,107,10,"WITH obj AS (
    SELECT oid, ndet, firstmjd, lastmjd
    FROM object
    WHERE ndet > 500
),
prob AS (
    SELECT oid, probability
    FROM probability
    WHERE class_name = 'asteroid'
      AND classifier_name = 'stamp_classifier'
      AND classifier_version = 'stamp_classifier_1.0.4'
      AND probability > 0.5
      AND ranking = 1
),
ss AS (
    SELECT oid, candid, ssdistnr, ssnamenr
    FROM ss_ztf
    WHERE ssdistnr < 2
),
det AS (
    SELECT candid, oid, mjd, fid
    FROM detection
)
SELECT
    obj.oid,
    obj.ndet,
    obj.firstmjd,
    obj.lastmjd,
    prob.probability,
    ss.candid,
    ss.ssdistnr,
    ss.ssnamenr,
    det.mjd,
    det.fid
FROM obj
INNER JOIN prob ON obj.oid = prob.oid
INNER JOIN ss ON obj.oid = ss.oid
INNER JOIN det ON ss.candid = det.candid
ORDER BY obj.firstmjd
LIMIT 10
