0.22.0,gpt-5.2-codex,v4,107,9,"SELECT
    o.oid,
    o.ndet,
    o.firstmjd,
    o.lastmjd,
    p.probability,
    s.candid,
    s.ssdistnr,
    s.ssnamenr,
    d.mjd,
    d.fid
FROM (
    SELECT oid, ndet, firstmjd, lastmjd
    FROM object
    WHERE ndet > 500
) o
INNER JOIN (
    SELECT oid, probability
    FROM probability
    WHERE class_name = 'asteroid'
      AND classifier_name = 'stamp_classifier'
      AND classifier_version = 'stamp_classifier_1.0.4'
      AND probability > 0.5
      AND ranking = 1
) p ON o.oid = p.oid
INNER JOIN (
    SELECT oid, candid, ssdistnr, ssnamenr
    FROM ss_ztf
    WHERE ssdistnr < 2
) s ON o.oid = s.oid
INNER JOIN detection d ON s.candid = d.candid
ORDER BY o.firstmjd
LIMIT 10
